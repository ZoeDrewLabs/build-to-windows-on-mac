# Perfil do PEAK (Steam appid 3527290) — Unity 6, DirectX 12 → D3DMetal
# Cada correção de bug do PEAK entra aqui, com um comentário dizendo o porquê.
STEAM_APPID=3527290

# Chave do registro onde o PEAK guarda as configurações (salvas em peak.config.reg).
SETTINGS_KEY='HKCU\Software\LandCrab\PEAK'

# Desempenho (17/11/2026, MacBook Air M4): o D3DMetal desenha na resolução nativa
# (3420x2224). Retina desligado e resolução no registro NÃO mudam isso. O que funciona
# é o menu do jogo: Render Scale "Medium" + limite de FPS. Resultado: 31 FPS, GPU 18 ms.

# Contador de FPS da Apple sempre ligado no PEAK? Descomente:
# MTL_HUD_ENABLED=1
